@page "/directions/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

@* <PageTitle>Delete</PageTitle> *@

@* <h1>Delete</h1> *@

@* <p>Are you sure you want to delete this?</p> *@
<div>
    <h2>Удалить напраление: <br> "@direction?.direction_name"?</h2>
    <hr />
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        @* <dl class="row">
            <dt class="col-sm-2">Направление обучения:</dt>
            <dd class="col-sm-10">@direction.direction_name</dd>
        </dl> *@
        <EditForm Model="direction" OnValidSubmit="DeleteDirection" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(direction is null)">Delete</button> |
            <a href="/directions">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int? direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (direction_id is null || direction_id <= 0)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
        byte id = (byte)direction_id.Value;
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == id);

        if (direction is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
    }

    private async Task DeleteDirection()
    {
        using var context = DbFactory.CreateDbContext();
        var existing = await context.Directions.FindAsync(direction!.direction_id);
        if (existing is not null)
        {
            context.Directions.Remove(existing);
            await context.SaveChangesAsync();
        }
        NavigationManager.NavigateTo("/directions");
    }
}
