@page "/directions/edit/{direction_id:int}"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

@* <PageTitle>Edit</PageTitle> *@

@* <h1>Edit</h1> *@

<h2>Редактирование направления обучения</h2>
<hr />
@if (Direction is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Direction" OnValidSubmit="UpdateDirection" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="direction_id" value="@Direction.direction_id" />
                <div class="mb-3">
                    <label for="direction_name" class="form-label">Направление обучения:</label>
                    <InputText id="direction_name" @bind-Value="Direction.direction_name" class="form-control" />
                    <ValidationMessage For="() => Direction.direction_name" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/directions">Back to List</a>
</div>

@code {
    [Parameter]
    public int direction_id { get; set; }

    [SupplyParameterFromForm]
    private Direction? Direction { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        byte id = (byte)direction_id;
        Direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (Direction is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDirection()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Direction!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DirectionExists(Direction!.direction_id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/directions");
    }

    private bool DirectionExists(byte direction_id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Directions.Any(e => e.direction_id == direction_id);
    }
}
