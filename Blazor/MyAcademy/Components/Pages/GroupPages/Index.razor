@page "/groups"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Groups</PageTitle>

<div class="controls">
    <h1>Группы</h1>
    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>

    <form action="/groups">
        <input type="search" name="groupFilter" placeholder="Группа"/>
        <input type="search" name="directionFilter" placeholder="Направление" />
        <input type="submit" value="Поиск" class="btn btn-primary"/>
    </form>
    <div>
        <label for="items-per-page"></label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="13">13</option>
        </select>
    </div>
</div>

<div>
    <div class="grid-container">
        <QuickGrid Class="table" Items="FilteredGroups" Pagination="pagination">
            <PropertyColumn Property="group => group.group_id" Sortable="true"/>
            <TemplateColumn Context = "group"
            Title="Группа"
            SortBy="@sortByGroup">
                <a href="@($"groups/details?group_id={group.group_id}")">@group.group_name</a>
            </TemplateColumn>
            <PropertyColumn Property="group => group.Direction.direction_name" Sortable="true"/>
            <PropertyColumn Property="group => new Week((int)(group.learning_days ?? 0))" />
            <PropertyColumn Property="group => group.start_time" />
            <PropertyColumn Property="group => group.start_date" />

            @* <TemplateColumn Context="group">
                <a href="@($"groups/edit?group_id={group.group_id}")">Edit</a> |
                <a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
                <a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
            </TemplateColumn> *@
        </QuickGrid>
    </div>
    <Paginator State="pagination"/>
</div>

@code {
    private MyAcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 13 };

    GridSort<Group> sortByGroup = GridSort<Group>.ByAscending(group => group.group_name);

    [SupplyParameterFromQuery]
    string groupFilter { get; set; } = null;
    [SupplyParameterFromQuery]
    string directionFilter { get; set; } = null;

    private IQueryable<Group> FilteredGroups =>
        context.Groups
        .Include(group => group.Direction)
        .Where(group => group.group_name.Contains(groupFilter ?? string.Empty))
        .Where(group => group.Direction.direction_name.Contains(directionFilter ?? string.Empty));


    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
