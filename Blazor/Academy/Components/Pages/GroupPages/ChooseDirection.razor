@using Academy.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory

<div class="mb-3">
    <span class="text-danger">*</span>
    <label for="direction" class="form-label">direction:</label> 
    <InputSelect id="direction" @bind-Value="Group.direction" class="form-control">
        @if (ShowPlaceholder)
        {
            <option selected disabled value="0"> --- Выберите направление обучения --- </option>
        }
        @using (Academy.Data.AcademyContext context = DbFactory.CreateDbContext())
        {
            @foreach (Direction direction in context.Directions)
            {
                <option value="@direction.direction_id">@direction.direction_name</option>
            }
        }
    </InputSelect>
    @* <InputNumber id="direction" @bind-Value="Group.direction" class="form-control" aria-required="true"/> *@ 
    <ValidationMessage For="() => Group.direction" class="text-danger" /> 
</div>       

@code 
{
    [Parameter]
    public Group Group { get; set; }

    [Parameter]
    public bool ShowPlaceholder { get; set; }
}
