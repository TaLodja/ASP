@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Groups</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Group</h2>
    <hr /> *@
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@group.group_name</h1>
            <p>
                <a href="@($"/groups/edit?group_id={group.group_id}")" class="btn btn-primary">Edit</a>
            </p>
        </div>
        <dl class="row">
            <dt class="col-sm-2">Количество студентов:</dt>
            <dd class="col-sm-10">@group.Students.Count</dd>
            <dt class="col-sm-2">direction</dt>
            <dd class="col-sm-10">@group.Direction.direction_name</dd>
            <dt class="col-sm-2">learning_days</dt>
            <dd class="col-sm-10">@(new Week((int)(group.learning_days ?? 0)))</dd>
            <dt class="col-sm-2">start_time</dt>
            <dd class="col-sm-10">@group.start_time</dd>
            <dt class="col-sm-2">start_date</dt>
            <dd class="col-sm-10">@group.start_date</dd>
        </dl>
        <div>
            <a href="@($"/groups")">Back to List</a>
        </div>
        <hr />
        <ol>
            @foreach(Student student in group.Students)
            {
                <li>
                    <a href="@($"/students/details?stud_id={student.stud_id}")">@($"{student.last_name} {student.first_name} {student.middle_name}")</a>
                </li>
            }
        </ol>
    }
</div>

@code {
    private Group? group;

    [SupplyParameterFromQuery]
    private int group_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        group = await context.Groups.Include(g => g.Direction).Include(g => g.Students).FirstOrDefaultAsync(m => m.group_id == group_id);

        if (group is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
