@page "/students"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy.Models
@using Academy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory

<PageTitle>Students</PageTitle>

<h1>Студенты</h1>
<div class="controls">
    <p>
        <a href="students/create" class="btn btn-primary">Добавить</a>
    </p>
    <form action="/students">
        <input type="search" name="lastnameFilter" placeholder="Фамилия"/>
        <input type="search" name="firstnameFilter" placeholder="Имя"/>
        <input type="search" name="groupFilter" placeholder="Группа"/>
        <input type="submit" value="Поиск" class="btn btn-primary"/>
    </form>
    <div>
        <label for="items-per-page"></label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
    </div>
</div>

<div>
    <div class="grid-container">
        <QuickGrid Class="table" Items="FilteredStudents" Pagination="pagination">
            <PropertyColumn Property="student => student.last_name" Title="Фамилия" Sortable="true"/>
            <PropertyColumn Property="student => student.first_name" Title="Имя"/>
            <PropertyColumn Property="student => student.middle_name" Title="Отчество" />
            <PropertyColumn Property="student => student.birth_date" Title="Дата рождения" Sortable="true"/>
            <PropertyColumn Property="student => student.email" Title="Email" />
            <PropertyColumn Property="student => student.phone" Title="Телефон"/>
            @* <PropertyColumn Property="student => student.photo" /> *@
            <TemplateColumn Title="Группа" Context="student" SortBy="@sortByGroup">
                @if (student.Group != null)
                {
                    <span>@student.Group.group_name</span>
                }
                else
                {
                    <span>-</span>
                }
            </TemplateColumn>
            @* <PropertyColumn Property="student => student.group" /> *@

            <TemplateColumn Context="student">
                <a href="@($"students/details?stud_id={student.stud_id}")">Details</a>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <Paginator State="pagination"/>
</div>

@code {
    private AcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    GridSort<Student> sortByGroup = GridSort<Student>.ByAscending(student => student.Group!.group_name);

    [SupplyParameterFromQuery]
    string lastnameFilter { get; set; }
    [SupplyParameterFromQuery]
    string firstnameFilter { get; set; }
    [SupplyParameterFromQuery]
    string groupFilter { get; set; }

    private IQueryable<Student> FilteredStudents =>
        context.Students
        .Include(student => student.Group)
        .Where(student => student.last_name.Contains(lastnameFilter ?? string.Empty))
        .Where(student => student.first_name.Contains(firstnameFilter ?? string.Empty))
        .Where(student => student.Group.group_name.Contains(groupFilter ?? string.Empty));

        // .Where
        // (
        //     student => student.last_name.Contains(titleFilter ?? string.Empty) ||
        //     student => student.first_name.Contains(titleFilter ?? string.Empty) ||
        //     student => student.middle_name.Contains(titleFilter ?? string.Empty)
        // )

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
