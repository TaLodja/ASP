@page "/teachers"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Teachers</PageTitle>

<div class=controls>
    <h1>Преподаватели (@context.Teachers.Count())</h1>
    <p>
        <a href="teachers/create" class="btn btn-primary">Добавить</a>
    </p>
    <form action="/teachers">
        <input type="search" name="lastnameFilter" placeholder="Фамилия"/>
        <input type="submit" value="Поиск" class="btn btn-primary"/>
    </form>
    <div>
        <label for="items-per-page"></label>
        <select @bind="@pagination.ItemsPerPage" id="items-per-page">
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="20">20</option>
        </select>
    </div>
</div>

<div>
    <div class="grid-container">
        <QuickGrid Class="table" Items="FilteredTeachers" Pagination="pagination">
            <PropertyColumn Title="№ п/п" Property="teacher => teacher.teacher_id" Sortable="true"/>
            <TemplateColumn Context="teacher"
                            Title="Преподаватель"
                            SortBy="@sortByName">
                <a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">@teacher.FullName</a>
            </TemplateColumn>
            <PropertyColumn Title="Дата рождения" Property="teacher => teacher.birth_date" Sortable="true" />
            <TemplateColumn Context="teacher"
                            Title="Возраст"
                            SortBy="@sortByAge">
                @teacher.FullAge
            </TemplateColumn>
            <PropertyColumn Title="Работает с" Property="teacher => teacher.work_since" Sortable="true" />
            <PropertyColumn Title="Ставка" Property="teacher => teacher.rate" />

            @* <TemplateColumn Context="teacher">
                <a href="@($"teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |
                <a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">Details</a> |
                <a href="@($"teachers/delete?teacher_id={teacher.teacher_id}")">Delete</a>
            </TemplateColumn> *@
        </QuickGrid>
    </div>
    <Paginator State="pagination"/>
</div>

@code {
    private MyAcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

    GridSort<Teacher> sortByName = GridSort<Teacher>.ByAscending(t => t.last_name);
    GridSort<Teacher> sortByAge = GridSort<Teacher>.ByAscending(d => d.birth_date);

    [SupplyParameterFromQuery]
    string lastnameFilter { get; set; }

    private IQueryable<Teacher> FilteredTeachers =>
        context.Teachers
        .Where(t => t.last_name.Contains(lastnameFilter ?? string.Empty));

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
