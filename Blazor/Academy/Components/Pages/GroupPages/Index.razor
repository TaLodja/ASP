@page "/groups"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy.Models
@using Academy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory

<PageTitle>Groups</PageTitle>

<h1>Группы</h1>

<div class="controls">
    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>
    <form action="/groups">
        <input type="search" name="groupFilter" placeholder="Группа"/>
        <input type="search" name="directionFilter"placeholder="Направление" />
        <input type="submit" value="Поиск" class="btn btn-primary"/>
    </form>
    <div>
        <label for="items-per-page"></label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="13">13</option>
        </select>
    </div>
</div>
<div>
    <div class=grid-container>
        <QuickGrid Class="table" Items="FilteredGroups" Pagination="pagination">
            <PropertyColumn Property="group => group.group_id" Sortable="true"/>
            <PropertyColumn Property="group => group.group_name" Sortable="true"/>
            <TemplateColumn Title="direction" Context="group" SortBy="@sortByDirection">
                @if (group.Direction !=null)
                {
                    <span>@group.Direction.direction_name</span>
                }
                else
                {
                    <span>-</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="weekdays" Context="group">
                <span>@GetWeekdaysStirng(group.weekdays)</span>
            </TemplateColumn>
            @* <PropertyColumn Property="group => group.weekdays" /> *@
            <PropertyColumn Property="group => group.start_time" />
            <PropertyColumn Property="group => group.start_date" />

            <TemplateColumn Context="group">
                <a href="@($"groups/details?group_id={group.group_id}")">Details</a>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <Paginator State="pagination" />
</div>

@code {
    private AcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    GridSort<Group> sortByDirection = GridSort<Group>.ByAscending(group => group.Direction!.direction_name);

    [SupplyParameterFromQuery]
    string groupFilter { get; set; }
    [SupplyParameterFromQuery]
    string directionFilter { get; set; }

    private IQueryable<Group> FilteredGroups =>
        context.Groups
        .Include(group => group.Direction)
        .Where(group => group.group_name.Contains(groupFilter ?? string.Empty))
        .Where(group => group.Direction.direction_name.Contains(directionFilter ?? string.Empty));

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    private string GetWeekdaysStirng(int? weekdays)
    {
        if (weekdays == null || weekdays == 0) return "-";
        List<string> days = new List<string>();
        int value = weekdays.Value;
        if ((value & 1) == 1) days.Add("Пн");
        if ((value & 2) == 2) days.Add("Вт");
        if ((value & 4) == 4) days.Add("Ср");
        if ((value & 8) == 8) days.Add("Чт");
        if ((value & 16) == 16) days.Add("Пт");
        if ((value & 32) == 32) days.Add("Сб");
        if ((value & 64) == 64) days.Add("Вс");
        return string.Join(",", days);
    }
}
