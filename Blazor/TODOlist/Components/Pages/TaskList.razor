@page "/TaskList"
@rendermode InteractiveServer

<h3>TaskList</h3>
<input type="text" @bind="description"/>
<button class="btn btn-primary" @onclick="AddTask">Добавить</button>

<ul>
	@foreach (TODO task in tasklist)
	{
		<li>
			<label>
				<input type="checkbox" @bind="@task.DONE" />
				<span class="task-text">@task.Description</span>
			</label>
			<button class="btn-delete" @onclick="() => DeleteTask(task)">x</button>
		</li>
	}
</ul>

<button class="btn btn-danger" @onclick="DeleteDoneTasks">
	Удалить все выполненные задания
</button>

<div>
	Всего задач: 
	<span style="font-size: 20px; font-weight: bold;color: black;">@TotalTasks</span>
</div>

<div>
	Выполнено задач: 
	<span style="font-size: 20px; font-weight: bold;color: black;">@DoneTasks</span>
</div>

<div>
	Осталось задач: 
	<span style="font-size: 20px; font-weight: bold;color: black;">@UnfinishedTasks</span>
</div>

@code
{
	string description = "";
	List<TODO> tasklist =
	[
	new TODO{ Description = "Полить цветы" },
	new TODO{ Description = "Покормить кота", DONE = true },
	new TODO{ Description = "Сходить в магаз", DONE = true }
	];
	//List<TODO> tasklist = new List<TODO>();
	int TotalTasks => tasklist.Count;
	int DoneTasks => tasklist.Count(task => task.DONE);
	int UnfinishedTasks => TotalTasks - DoneTasks;

	void AddTask()
	{
		if (!string.IsNullOrEmpty(description) && !string.IsNullOrWhiteSpace(description))
		{
			TODO task = new TODO { Description = description };
			if (tasklist.Contains(task)) return;
			tasklist.Add(task);
			description = "";
		}
	}
	void DeleteTask(TODO task)
	{
		tasklist.Remove(task);
	}
	void DeleteDoneTasks()
	{
		tasklist.RemoveAll(task => task.DONE);
		//for (int i = tasklist.Count-1; i >=0; i--)
		//{
		//	if (tasklist[i].DONE == true) tasklist.RemoveAt(i);
		//}
	}
}
