@page "/Fibonacci"
@rendermode InteractiveServer

@using System.Numerics

<h1>Fibonacci</h1>
<div class="fibonacci">
	<label for="number">Число элементов ряда Фибоначчи, которые следует вывести: </label>
	<input id="number" type="number" min="1" @bind="N" @bind:after="OutputFibonacci" />
</div>
<h3>Ряд Фибоначчи:<br> @string.Join(", ", fib)</h3>
